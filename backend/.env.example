# Copy to backend/.env for local development. This file is git-ignored; only .env.example is tracked.

# Matches the docker-compose Postgres (throwaway, local-only credentials).
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# --- LLM provider (platform independent) ---------------------------------------------------
# "fake" (default) needs no key and no network: use it for development and tests.
LLM_PROVIDER=fake

# For a real provider set LLM_PROVIDER and LLM_MODEL, and install its extra:
#   cd backend && uv sync --extra <openai|anthropic|google|ollama>
#
#   LLM_PROVIDER=openai        # also any OpenAI-compatible server, see LLM_BASE_URL
#   LLM_PROVIDER=anthropic
#   LLM_PROVIDER=google_genai  # extra: google
#   LLM_PROVIDER=ollama        # local models, no key needed
#
# LLM_MODEL=<model name for the chosen provider>
#
# API key: if LLM_API_KEY is unset, the provider's usual variable is used
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY). Never commit a real key.
# LLM_API_KEY=
#
# Endpoint override: OpenAI-compatible servers (vLLM, LM Studio, OpenRouter, ...) or a remote Ollama.
# LLM_BASE_URL=http://localhost:1234/v1
#
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=500

# Number of recent messages sent to the LLM as context.
# HISTORY_WINDOW=10
